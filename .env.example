# Compose namespace used for container, network, and volume names.
COMPOSE_PROJECT_NAME=backend-learning-platform

# Host HTTP port published by edge-nginx. No other service publishes a port.
HTTP_PORT=8080

# Container timezone. Application and database timestamps remain UTC.
TZ=Asia/Shanghai

# MySQL bootstrap credentials. Replace every change-me value before use.
MYSQL_ROOT_PASSWORD=change-me-root

# Database and least-privilege account used by platform-api.
MYSQL_PLATFORM_DATABASE=platform
MYSQL_PLATFORM_USER=platform_api
MYSQL_PLATFORM_PASSWORD=change-me-platform

# Restricted account reserved for orchestrator database routines.
MYSQL_ORCHESTRATOR_USER=orchestrator
MYSQL_ORCHESTRATOR_PASSWORD=change-me-orchestrator

# Internal platform-api listener.
PLATFORM_API_ADDR=:8080

# Shared Unix Domain Socket path used by platform-api and orchestrator.
ORCHESTRATOR_SOCKET_PATH=/run/platform/orchestrator.sock

# Internal lab gateway address resolved only on lab-control-net.
LAB_GATEWAY_ADDR=http://lab-gateway-nginx:8080

# Fully pinned build and runtime image baselines.
GO_IMAGE=golang:1.26.5-alpine3.23

# Go module proxy used inside Docker builds. Override for your network if needed.
GOPROXY=https://goproxy.cn,direct
NODE_IMAGE=node:24.18.0-alpine3.23
NGINX_IMAGE=nginx:1.30.3-alpine3.23
MYSQL_IMAGE=mysql:8.4.10

# Redis is reserved for future per-lab dynamic creation and is not a service here.
REDIS_IMAGE=redis:8.8.0-alpine3.23
SOCKET_PROXY_IMAGE=tecnativa/docker-socket-proxy:v0.4.2
ALPINE_IMAGE=alpine:3.23.5

# Trusted image template and dynamic lab resource limits.
LAB_APP_IMAGE=website-gobased/lab-app:dev
LAB_NETWORK_PREFIX=lab

# Maximum active labs and temporary containers across the platform.
LAB_MAX_ACTIVE=10
LAB_MAX_TEMP_CONTAINERS=40

# Per-session application instance and container limits.
LAB_MAX_INSTANCES_PER_SESSION=4
LAB_DEFAULT_CPU_CORES=0.1
LAB_DEFAULT_MEMORY_MB=128
LAB_DEFAULT_PIDS_LIMIT=64

# Per-session Redis memory baseline and lab lifecycle limits.
LAB_REDIS_MEMORY_MB=48
LAB_IDLE_TIMEOUT=10m
LAB_MAX_DURATION=30m

# Set false when accounts will be maintained through loopback-only MySQL access.
SEED_TEST_USERS=true
