{
  "templateId": "session_redis_v1",
  "templateVersion": 1,
  "resourceType": "container",
  "imageEnv": "REDIS_IMAGE",
  "command": [
    "redis-server",
    "--save",
    "",
    "--appendonly",
    "no",
    "--maxmemory",
    "48mb",
    "--maxmemory-policy",
    "allkeys-lru"
  ],
  "user": "redis",
  "publishPorts": false,
  "readOnlyRootFilesystem": true,
  "privileged": false,
  "capDrop": ["ALL"],
  "memoryLimitMb": 64,
  "pidsLimit": 32
}
